# Optional map tile provider. Leave unset for ordinary interactive OSM tiles.
# This value is public in the built browser app; never put private tokens here.
# Tiles send an origin-only Referer; do not strip it in hosting/proxy settings.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional Photon-compatible OSM geocoder endpoint (full API path).
# Default is the public Photon demo: reasonable use only, no availability guarantee.
# Use your own reviewed provider for larger deployments. URL is public: no secrets,
# userinfo, query parameters or fragments. HTTPS required; HTTP localhost only in dev.
VITE_GEOCODER_URL=https://photon.komoot.io/api/

# Optional HTTPS URL of YOUR deployed web app, including its trailing base path.
# Native trip links use this URL. Without it, native sharing sends a route summary.
# Leave empty until the web app is deployed; do not use localhost or private URLs.
VITE_PUBLIC_APP_URL=
