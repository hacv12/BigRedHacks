{
  "name": "brisa-navigation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "data:refresh": "python3 scripts/build_data.py --all --refresh",
    "data:list": "python3 scripts/build_data.py --list",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "build:native": "node scripts/build-native.mjs",
    "app:sync": "npm run build:native && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios",
    "icons": "node scripts/generate-icons.mjs",
    "test:pwa": "node scripts/test-pwa.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
